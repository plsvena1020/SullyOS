# ═══════════════════════════════════════════════════════════════
# SullyOS VPS · Caddy 反代配置（canonical，与生产 /etc/caddy/Caddyfile 同步）
# 安装时由 deploy/scripts/install.sh 用 sed 替换 ${SULLYOS_DOMAIN} / ${ACME_EMAIL}。
# 所有后端仅监听 127.0.0.1；这里只暴露 80/443（自动 HTTPS）。
#
# 端口矩阵：main-agent 8830 · instant-push 8831 · amsg 8832 · proactive-push 8833
#           wake-bridge 8834 · heartbeat 8835
# 既有 MCP 服务：xhs-mcp-http 8810 · xhs-mcp 8809 · ruota 8790 · kaleidoscope 8788
#                theseus-brain 8787 · phone-gateway 8795
# ═══════════════════════════════════════════════════════════════
${SULLYOS_DOMAIN}, mcp.${SULLYOS_DOMAIN} {
	email ${ACME_EMAIL}

	# 小红书 MCP (xhs-mcp) - Streamable HTTP
	handle_path /xhs-mcp-http* {
		reverse_proxy 127.0.0.1:8810
	}
	# Ruota della Fortuna MCP
	handle_path /ruota* {
		reverse_proxy 127.0.0.1:8790
	}
	# Kaleidoscope MCP (kaleidoscope-rp)
	handle_path /kaleidoscope* {
		reverse_proxy 127.0.0.1:8788
	}
	# 忒修斯之脑 MCP (theseus-brain)
	handle_path /theseus-brain* {
		reverse_proxy 127.0.0.1:8787
	}
	# 小红书 MCP (xhs-mcp)
	handle_path /xhs-mcp* {
		reverse_proxy 127.0.0.1:8809
	}
	# VPS 中转回复网关 (phone-chat-gateway)
	handle_path /phone-gateway* {
		reverse_proxy 127.0.0.1:8795
	}

	# ── SullyOS VPS 后端（8830-8835）─────────────────────
	# 主代理（LLM + MCP 循环；SSE 长连接：禁用缓冲逐包透传）
	handle_path /agent/* {
		reverse_proxy 127.0.0.1:8830 {
			flush_interval -1
		}
	}
	# instant-push（Web Push）
	handle_path /instant-push/* {
		reverse_proxy 127.0.0.1:8831
	}
	# amsg 定时消息
	handle_path /amsg/* {
		reverse_proxy 127.0.0.1:8832
	}
	# proactive-push 主动消息
	handle_path /proactive-push/* {
		reverse_proxy 127.0.0.1:8833
	}
	# 唤醒桥
	handle_path /wake-bridge/* {
		reverse_proxy 127.0.0.1:8834
	}
	# 心跳
	handle_path /heartbeat/* {
		reverse_proxy 127.0.0.1:8835
	}
	# xhs session bridge (token-gated, cookie stays on VPS)
	handle_path /xhs-api* {
		reverse_proxy 127.0.0.1:8836
	}
	# 家（sullyos-home 真相源）
	handle_path /home/* {
		reverse_proxy 127.0.0.1:8837
	}

	# 其余路径明确返回 404
	handle {
		respond 404
	}
}